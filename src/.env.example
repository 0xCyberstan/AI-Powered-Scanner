# Copy this file to .env and replace with your actual key.
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: only needed for cpython_scan.py if you want to use a system libclang
# instead of the one bundled with the `libclang` PyPI package. Set to the
# absolute path of libclang.so / libclang.dylib / libclang.dll.
# LIBCLANG_LIBRARY_FILE=/usr/lib/llvm-18/lib/libclang.so
